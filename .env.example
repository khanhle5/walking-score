# Server-only credentials from https://www.are.na/developers/oauth/applications
ARENA_CLIENT_ID=
ARENA_CLIENT_SECRET=

# ID or slug of a public, open Are.na channel for the walk gallery and uploads.
ARENA_WALKS_CHANNEL=

# Optional: override the public Firebase web config only if the deployed
# Mindstamps app uses a different project than the defaults in its source code.
# Configure all four together; these are client-side values, not admin keys.
# NEXT_PUBLIC_MINDSTAMPS_API_KEY=
# NEXT_PUBLIC_MINDSTAMPS_AUTH_DOMAIN=
# NEXT_PUBLIC_MINDSTAMPS_PROJECT_ID=
# NEXT_PUBLIC_MINDSTAMPS_APP_ID=

# Public Mapbox browser token (pk.*), with map and permanent geocoding access.
# NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional; defaults to mapbox://styles/mapbox/streets-v12
# NEXT_PUBLIC_MAPBOX_STYLE=
